# Advanced Prompts Factory - .gitignore
# Generated for a documentation/meta-prompts repository

# ============================================
# Operating Systems
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Linux
*~
.directory
.Trash-*
.nfs*

# ============================================
# IDEs and Editors
# ============================================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains IDEs (IntelliJ, WebStorm, PyCharm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
tags
[._]*.un~

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*
.org-id-locations
*_archive
*_flymake.*
flycheck_*.el
.projectile

# Sublime Text
*.sublime-project
*.sublime-workspace
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
sftp-config.json
Package Control.last-run
Package Control.ca-list
Package Control.ca-bundle
Package Control.system-ca-bundle
Package Control.cache/
Package Control.ca-certs/
Package Control.merged-ca-bundle
Package Control.user-ca-bundle
oscrypto-ca-bundle.crt
bh_unicode_properties.cache

# ============================================
# Node.js / npm (if using markdown tools)
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity
.cache/

# ============================================
# Python (if using Python-based tools)
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
ENV/
env/
.env

# ============================================
# PowerShell
# ============================================
*.ps1xml
*_profile.ps1

# ============================================
# Logs and Temporary Files
# ============================================
*.log
logs/
*.tmp
*.temp
tmp/
temp/
.cache/

# ============================================
# Backup Files
# ============================================
*.bak
*.backup
*.swp
*.swo
*~
\#*\#

# ============================================
# Testing and Coverage
# ============================================
coverage/
*.cover
*.coverage
.hypothesis/
.pytest_cache/
nosetests.xml
test-results/

# ============================================
# Build Artifacts
# ============================================
*.out
*.exe
*.o
*.a

# ============================================
# Documentation Build Artifacts
# ============================================
_site/
.jekyll-cache/
.jekyll-metadata
Gemfile.lock
.bundle/
vendor/

# ============================================
# Project Specific
# ============================================

# Ignore generated test projects
test-projects/
examples/generated/

# Ignore local development notes
notes/
.notes/
TODO.local.md
NOTES.md

# Ignore local configuration overrides
.env.local
.env.*.local
config.local.json

# Ignore editor-specific workspace files
*.code-workspace

# ============================================
# Security - Never Commit
# ============================================
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
secrets/
.secrets/
credentials.json
.credentials/

# ============================================
# Large Files (GitHub has 100MB limit)
# ============================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.dmg
*.iso
